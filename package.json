{
  "name": "skiss",
  "version": "0.0.0",
  "description": "A text notation for sketching data models, compiled to LinkML",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erik-naslund/skiss.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "skiss": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify:linkml",
    "verify:linkml": "if command -v python3 >/dev/null 2>&1; then scripts/linkml-env.sh && scripts/validate-linkml.sh; else echo 'verify: LinkML validation skipped, python3 not found'; fi"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.0.0",
    "jsdom": "^30.0.1",
    "mermaid": "^12.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
